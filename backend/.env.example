# Copy to .env and fill in real values.

PORT=5000
NODE_ENV=development

# Required. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production without a strong value here.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# SQLite database file. Defaults to backend/data/venuehub.db
DATABASE_FILE=

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to false to skip demo accounts/venues on a production database.
SEED_ON_START=true

# AI venue recommendation
# Set AI_PROVIDER=openai and add an OpenAI API key to enable AI explanations/ranking.
# Without these values, VenueHub automatically uses its local scoring fallback.
AI_PROVIDER=fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
