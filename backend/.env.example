NODE_ENV=development
PORT=5000

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
DATABASE_URL=YOUR_SUPABASE_SESSION_POOLER_CONNECTION_STRING

## Comma-separated Google email addresses that should receive administrator access.
## New users are CUSTOMER by default.
ADMIN_EMAILS=your-admin@gmail.com

## Venue booking timezone used by the scheduling layer.
APP_TIMEZONE=Asia/Kolkata

# AI Venue Advisor
AI_PROVIDER=fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Example production value:
# CORS_ORIGINS=https://venuehub.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SEED_ON_START=true

# Razorpay (test mode) — leave both blank to keep the built-in demo payment
# flow. Get test keys from Razorpay Dashboard > Settings > API Keys
# (make sure "Test Mode" is on). No real money moves in test mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
